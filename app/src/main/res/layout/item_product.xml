<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:padding="8dp">

    <!-- ẢNH SẢN PHẨM -->
    <ImageView
        android:id="@+id/imgFood"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_image_placeholder"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- TÊN SẢN PHẨM -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chicken Thai Biriyani"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/imgFood"
        app:layout_constraintTop_toTopOf="@id/imgFood"
        app:layout_constraintEnd_toStartOf="@id/btnMore"
        android:layout_marginStart="12dp" />

    <!-- CATEGORY -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Breakfast"
        android:textSize="12sp"
        android:textColor="#FF7A00"
        android:background="@drawable/bg_category"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvName" />

    <!-- STAR ICON -->
    <ImageView
        android:id="@+id/icStar"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_star"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvCategory"
        android:layout_marginTop="6dp" />

    <!-- RATING -->
    <TextView
        android:id="@+id/tvRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4.9"
        android:textColor="#FF7A00"
        android:textSize="13sp"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/icStar"
        app:layout_constraintTop_toTopOf="@id/icStar" />

    <!-- REVIEW -->
    <TextView
        android:id="@+id/tvReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(10 Review)"
        android:textColor="#999999"
        android:textSize="12sp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@id/tvRating"
        app:layout_constraintTop_toTopOf="@id/tvRating" />

    <!-- MENU MORE -->
    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
