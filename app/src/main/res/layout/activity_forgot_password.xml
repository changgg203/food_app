<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F0"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header cong cam nhạt + nút back -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_register_header">   <!-- dùng lại drawable cũ -->

            <!-- Nút Back -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#9BA4B7"
                android:scaleType="centerInside" />

            <!-- Tiêu đề -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="90dp"
                android:text="Quên mật khẩu"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Mô tả -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="140dp"
                android:layout_marginHorizontal="40dp"
                android:gravity="center"
                android:text="Vui lòng đăng nhập vào tài khoản hiện có"
                android:textColor="#888888"
                android:textSize="16sp" />

        </RelativeLayout>

        <!-- Form bên dưới -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingTop="40dp"
            android:paddingBottom="60dp">

            <!-- EMAIL label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textColor="#9BA4B7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Ô nhập email (dùng lại bg_input_field) -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="example@gmail.com"
                android:textColorHint="#BBC1CD"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textSize="15sp" />

            <!-- Nút GỬI (dùng lại bg_btn_orange) -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_btn_orange"
                android:text="GỬI"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>