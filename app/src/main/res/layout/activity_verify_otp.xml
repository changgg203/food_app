<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF4F0">

    <!-- Nút back -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Quay lại"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#9BA4B7"
        android:scaleType="centerInside" />


    <!-- Tiêu đề Xác minh -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác minh"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp" />

    <!-- Dòng mô tả -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chúng tôi đã gửi một mã đến email của bạn."
        android:textSize="15sp"
        android:textColor="#666666"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="40dp"
        android:gravity="center" />

    <!-- Ô nhập mã OTP 4 số -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp">

        <EditText android:id="@+id/otp1" android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/otp_box" android:gravity="center" android:inputType="number"
            android:maxLength="1" android:textSize="28sp" android:layout_margin="8dp"/>

        <EditText android:id="@+id/otp2" android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/otp_box" android:gravity="center" android:inputType="number"
            android:maxLength="1" android:textSize="28sp" android:layout_margin="8dp"/>

        <EditText android:id="@+id/otp3" android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/otp_box" android:gravity="center" android:inputType="number"
            android:maxLength="1" android:textSize="28sp" android:layout_margin="8dp"/>

        <EditText android:id="@+id/otp4" android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/otp_box" android:gravity="center" android:inputType="number"
            android:maxLength="1" android:textSize="28sp" android:layout_margin="8dp"/>
    </LinearLayout>

    <!-- Dòng Resend -->
    <TextView
        android:id="@+id/tv_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend in 50sec"
        android:textSize="14sp"
        android:textColor="#FF6B35"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true" />

    <!-- Nút XÁC MINH -->
    <Button
        android:id="@+id/btn_verify"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="XÁC MINH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_orange"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="48dp"
        android:elevation="4dp" />

    <!-- Bàn phím số (sử dụng hệ thống) -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>